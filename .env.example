# SecureData Central -- variaveis de ambiente (todas OPCIONAIS; ha default).
# Copie para .env e ajuste. NENHUM secret vive aqui -- este servidor so
# fala com o SQLite local.

# Caminho do banco. Precedencia: SDC_DB_PATH > DATABASE_URL > default.
# Default local: ./storage/securedata.db
# SDC_DB_PATH=/data/securedata.db
# DATABASE_URL=sqlite:////data/securedata.db

# Liga/desliga o servidor MCP (o SDK em processo continua funcionando).
SDC_MCP_ENABLED=true

# Orcamento de tokens do Context Engine (sdc_get_context).
SDC_MAX_CONTEXT_TOKENS=2000

# Nivel de log (vai para stderr; stdout e reservado ao protocolo MCP).
SDC_LOG_LEVEL=INFO

# Limites de validacao de entrada.
SDC_MAX_CONTENT_CHARS=20000
SDC_MAX_KEY_CHARS=200
SDC_MAX_QUERY_CHARS=1000
SDC_MAX_METADATA_BYTES=8192
SDC_DEFAULT_SEARCH_LIMIT=5
SDC_MAX_SEARCH_LIMIT=50

# Busca semantica opcional (requer requirements-optional.txt).
# Desligada por padrao; o primeiro import e pesado.
SDC_ENABLE_SEMANTIC_SEARCH=false
